[Unit]
Description=Code Bot USB info display daemon (CH32X033F8P6)
Documentation=https://github.com/code-bot/code-bot-service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Foreground mode is default since the daemon now handles its own PID file
# + control port; ``--foreground`` is implicit.
# @CODEBOTD_PATH@ is substituted with `shutil.which("codebotd")` at install
# time by `codebotd setup`, so this unit always points at the actual binary
# no matter where pip put it (system Python, --user, venv).
ExecStart=@CODEBOTD_PATH@ start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening (defense in depth)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=default.target
