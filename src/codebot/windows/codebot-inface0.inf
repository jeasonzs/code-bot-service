; Code Bot USB device - WinUSB driver binding for interface 0 (Vendor)
;
; This INF binds ONLY interface 0 (Vendor Specific) to WinUSB so that
; pyusb can talk to EP1/EP2/EP5. Interface 1 (HID Keyboard) is left on
; the system default driver so the HID Keyboard function (EP3 IN) keeps
; working as a standard USB keyboard.
;
; Install with (Administrator PowerShell or cmd):
;
;     codebotd setup-driver
;
; or manually:
;
;     pnputil /add-driver windows\codebot-inface0.inf /install
;
; Uninstall:
;
;     pnputil /remove-device "USB\VID_1A86&PID_CB0B"  ; if previously bound
;     pnputil /delete-driver codebot-inface0.inf /uninstall /force
;
; Hardware IDs: USB\VID_1A86&PID_CB0B&MI_00  (interface 0)

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ProviderName%
CatalogFile = codebot-inface0.cat
DriverVer   = 01/01/2025,1.0.0.0

; -------- Manufacturer/Models --------
[Manufacturer]
%ProviderName% = CodeBotModels, NTamd64

[CodeBotModels.NTamd64]
%USB\MyDevice.DeviceDesc% = USB_Install, USB\VID_1A86&PID_CB0B&MI_00

; -------- Device installation --------
[USB_Install]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.Services]
Include=winusb.inf
AddService=WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName     = %WinUSB_SvcDesc%
ServiceType     = 1
StartType       = 3
ErrorControl    = 1
ServiceBinary   = %12%\WinUSB.sys

[USB_Install.Wdf]
KmdfService=WINUSB, WinUsb_Install

[WinUSB_Install]
KmdfLibraryVersion=1.15

[USB_Install.HW]
AddReg=Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{6E45736A-2EBB-44A6-9D90-3DB6B3E4F8F1}"

[USB_Install.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[CoInstallers_AddReg]
HKR,,CoInstallers32,0x00010000,"WdfCoInstaller01015.dll,WdfCoInstaller","WinUsbCoInstaller2.dll"

[CoInstallers_CopyFiles]
WinUsbCoInstaller2.dll
WdfCoInstaller01015.dll

[DestinationDirs]
CoInstallers_CopyFiles=11

; -------- Source/Disk --------
[SourceDisksNames]
1 = %DISK_NAME%,,,\i386
2 = %DISK_NAME%,,,\amd64

[SourceDisksFiles.x86]
WinUsbCoInstaller2.dll=1
WdfCoInstaller01015.dll=1

[SourceDisksFiles.amd64]
WinUsbCoInstaller2.dll=2
WdfCoInstaller01015.dll=2

; -------- Strings --------
[Strings]
ProviderName      = "Code Bot Project"
USB\MyDevice.DeviceDesc = "Code Bot USB Display (Interface 0 - Vendor)"
WinUSB_SvcDesc    = "WinUSB - Kernel Driver 01/01/2025"
DISK_NAME         = "Code Bot USB Display Installation Disk"
